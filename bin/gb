#!/usr/bin/env node
/**
 * gb — set up and drive this app from a shell.
 *
 * The wizard is the point: a fresh clone needs five decisions (model endpoint,
 * computer, sign-in, and two confirmations) and none of them should require
 * reading a .env file. Every command also works non-interactively, so the same
 * verbs are usable in a script and in CI.
 *
 * Nothing here writes a secret to stdout, and nothing prints a key back.
 */
import { spawn } from 'node:child_process';
import { randomBytes } from 'node:crypto';
import fs from 'node:fs';
import fsp from 'node:fs/promises';
import net from 'node:net';
import os from 'node:os';
import path from 'node:path';
import readline from 'node:readline';
import { fileURLToPath } from 'node:url';

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const ENV_FILE = path.join(ROOT, '.env');
const EXAMPLE = path.join(ROOT, '.env.example');

// ---------- tiny terminal kit ----------
// No dependency and no colour when the output is not a terminal: ANSI codes in a
// log file are noise.

const TTY = process.stdout.isTTY && !process.env.NO_COLOR;
const paint = (code) => (s) => (TTY ? `\x1b[${code}m${s}\x1b[0m` : String(s));
const bold = paint('1');
const dim = paint('2');
const green = paint('32');
const yellow = paint('33');
const red = paint('31');
const cyan = paint('36');

const say = (s = '') => process.stdout.write(`${s}\n`);
const ok = (s) => say(`${green('✓')} ${s}`);
const warn = (s) => say(`${yellow('!')} ${s}`);
const bad = (s) => say(`${red('✗')} ${s}`);
const note = (s) => say(`${dim(s)}`);

function heading(s) {
  say('');
  say(bold(s));
}

/** Ask a question. Returns the default when stdin is not interactive. */
function rl() {
  return readline.createInterface({ input: process.stdin, output: process.stdout });
}

async function ask(question, fallback = '') {
  if (!process.stdin.isTTY) return fallback;
  const r = rl();
  try {
    const answer = await new Promise((resolve) => r.question(`${cyan('?')} ${question}${fallback ? ` ${dim(`[${fallback}]`)}` : ''} `, resolve));
    return String(answer).trim() || fallback;
  } finally {
    r.close();
  }
}

/** Pick one of `options`. Number keys, and Enter takes the default. */
async function choose(question, options, defaultIndex = 0) {
  say(`${cyan('?')} ${question}`);
  options.forEach((o, i) => {
    const marker = i === defaultIndex ? cyan('›') : ' ';
    const badge = o.free ? ` ${green('[free]')}` : '';
    say(`  ${marker} ${bold(String(i + 1))}. ${o.label}${badge}${o.hint ? ` ${dim(`— ${o.hint}`)}` : ''}`);
  });
  if (!process.stdin.isTTY) return defaultIndex;
  for (;;) {
    const raw = await ask('Number', String(defaultIndex + 1));
    const n = Number(raw);
    if (Number.isInteger(n) && n >= 1 && n <= options.length) return n - 1;
    warn(`Enter a number between 1 and ${options.length}.`);
  }
}

async function confirm(question, yes = true) {
  const raw = (await ask(`${question} ${dim('(y/n)')}`, yes ? 'y' : 'n')).toLowerCase();
  return raw === 'y' || raw === 'yes';
}

/** A password prompt that does not echo. Falls back to a plain read when piped. */
async function askSecret(question) {
  if (!process.stdin.isTTY) return ask(question, '');
  return new Promise((resolve) => {
    const r = rl();
    const onData = () => {
      // A paste arrives in one chunk, newline included: always redraw the mask,
      // never the key. The newline itself is stripped by readline and .trim().
      process.stdout.write(`\r\x1b[K${cyan('?')} ${question} ${'*'.repeat(8)}`);
    };
    process.stdin.on('data', onData);
    r.question(`${cyan('?')} ${question} `, (answer) => {
      process.stdin.off('data', onData);
      process.stdout.write('\n');
      r.close();
      resolve(String(answer).trim());
    });
  });
}

// ---------- .env read/write ----------

/** Parse KEY=value lines, keeping comments and order so a rewrite is a diff of one line. */
function readEnvFile(file = ENV_FILE) {
  if (!fs.existsSync(file)) return { lines: [], values: {} };
  const lines = fs.readFileSync(file, 'utf8').split('\n');
  const values = {};
  for (const line of lines) {
    const m = /^\s*([A-Z][A-Z0-9_]*)\s*=\s*(.*)$/.exec(line);
    if (!m) continue;
    let v = m[2];
    const hash = v.indexOf(' #');
    if (hash >= 0) v = v.slice(0, hash);
    v = v.trim().replace(/^["']|["']$/g, '');
    values[m[1]] = v;
  }
  return { lines, values };
}

/** Set keys in .env, preserving comments. Creates the file from the example first. */
async function writeEnv(patch) {
  let lines;
  if (fs.existsSync(ENV_FILE)) {
    lines = fs.readFileSync(ENV_FILE, 'utf8').split('\n');
  } else if (fs.existsSync(EXAMPLE)) {
    lines = fs.readFileSync(EXAMPLE, 'utf8').split('\n');
  } else {
    lines = [];
  }
  for (const [key, value] of Object.entries(patch)) {
    const idx = lines.findIndex((l) => new RegExp(`^\\s*#?\\s*${key}\\s*=`).test(l));
    // Keep the inline comment a template line carries; it is documentation the
    // user reads, not part of the value.
    const carried = idx >= 0 ? (/\s+#.*$/.exec(lines[idx])?.[0] ?? '') : '';
    // An empty value with a trailing comment reads as a comment, not a value:
    // `ALLOWED_EMAILS=   # ...` parses as ALLOWED_EMAILS="# ...". Keep the gap.
    const entry = value === '' && carried ? `${key}= ${carried.trimStart()}` : `${key}=${value}${carried}`;
    if (idx >= 0) lines[idx] = entry;
    else {
      // Append under the last non-empty line so the file does not grow a gap.
      while (lines.length && lines[lines.length - 1] === '') lines.pop();
      lines.push(entry, '');
    }
  }
  await fsp.writeFile(ENV_FILE, lines.join('\n'));
  try { await fsp.chmod(ENV_FILE, 0o600); } catch { /* windows */ }
}

// ---------- probes ----------

async function httpProbe(url, init = {}, timeoutMs = 8000) {
  try {
    const res = await fetch(url, { ...init, signal: AbortSignal.timeout(timeoutMs) });
    const text = await res.text();
    let json;
    try { json = JSON.parse(text); } catch { json = null; }
    return { ok: res.ok, status: res.status, json, text };
  } catch (e) {
    return { ok: false, status: 0, json: null, text: String(e?.message ?? e) };
  }
}

/**
 * The saved base stays the bare origin (the Anthropic SDK inside Hermes adds
 * /v1 itself); the probe has to add it, since the API lives at /v1/messages.
 */
const anthropicApi = (base) => `${base.replace(/\/+$/, '').replace(/\/v1$/, '')}/v1`;

/** Ask the endpoint which models it serves. Same idea as `opencode`'s discovery. */
async function discoverModels(base, key, provider) {
  if (provider === 'anthropic') {
    const r = await httpProbe(`${anthropicApi(base)}/models`, { headers: { 'x-api-key': key, 'anthropic-version': '2023-06-01' } });
    const list = r.json?.data ?? r.json?.models ?? [];
    return Array.isArray(list) ? list.map((m) => String(m.id ?? m.name ?? '')).filter(Boolean) : [];
  }
  const r = await httpProbe(`${base}/models`, { headers: key ? { Authorization: `Bearer ${key}` } : {} });
  const list = r.json?.data ?? r.json?.models ?? (Array.isArray(r.json) ? r.json : []);
  return Array.isArray(list) ? list.map((m) => String(m.id ?? m.name ?? '')).filter(Boolean) : [];
}

/** One real completion, because /models answering does not mean a key works. */
async function testCompletion(base, key, model, provider) {
  if (provider === 'anthropic') {
    const r = await httpProbe(`${anthropicApi(base)}/messages`, {
      method: 'POST',
      headers: { 'x-api-key': key, 'anthropic-version': '2023-06-01', 'content-type': 'application/json' },
      body: JSON.stringify({ model, max_tokens: 8, messages: [{ role: 'user', content: 'Say OK' }] }),
    }, 30000);
    if (!r.ok) return { ok: false, detail: r.json?.error?.message ?? r.text.slice(0, 160) };
    return { ok: true, detail: r.json?.content?.[0]?.text ?? 'OK' };
  }
  const r = await httpProbe(`${base}/chat/completions`, {
    method: 'POST',
    headers: { Authorization: `Bearer ${key}`, 'content-type': 'application/json' },
    body: JSON.stringify({ model, max_tokens: 8, messages: [{ role: 'user', content: 'Say OK' }] }),
  }, 30000);
  if (!r.ok) return { ok: false, detail: r.json?.error?.message ?? r.text.slice(0, 160) };
  return { ok: true, detail: r.json?.choices?.[0]?.message?.content ?? 'OK' };
}

function dockerAvailable() {
  return new Promise((resolve) => {
    const p = spawn('docker', ['version', '--format', '{{.Server.Version}}'], { stdio: 'ignore' });
    p.on('error', () => resolve({ ok: false, reason: 'docker is not installed' }));
    p.on('exit', (code) => resolve(code === 0 ? { ok: true } : { ok: false, reason: 'the docker daemon is not reachable' }));
  });
}

function imageExists(name) {
  return new Promise((resolve) => {
    const p = spawn('docker', ['image', 'inspect', name], { stdio: 'ignore' });
    p.on('error', () => resolve(false));
    p.on('exit', (code) => resolve(code === 0));
  });
}

function hermesAvailable() {
  return new Promise((resolve) => {
    const p = spawn('hermes', ['--version'], { stdio: 'ignore' });
    p.on('error', () => resolve(false));
    p.on('exit', (code) => resolve(code === 0));
  });
}

function portFree(port) {
  return new Promise((resolve) => {
    const s = net.createServer();
    s.once('error', () => resolve(false));
    s.once('listening', () => s.close(() => resolve(true)));
    s.listen(port, '127.0.0.1');
  });
}

// ---------- commands ----------

/**
 * The providers offered at setup, ordered by what costs the user nothing.
 *
 * Two facts decide this list, and both come from Hermes' own registry
 * (hermes_cli/auth.py, _REGISTRY_ROWS and CANONICAL_PROVIDERS):
 * - A provider either takes an API key (`env`) or is reached over OAuth. OAuth
 *   ones are the only path that can be free without a card.
 * - OpenRouter carries ten `:free` SKUs, so a free key there is real. Nous
 *   Portal has a welcome trial pinned to one model, `nous/welcome`.
 *
 * Everything else here is a paid key. Listing them is not an endorsement; it is
 * the shortest path for someone who already has one.
 */
const PROVIDERS = [
  {
    id: 'openrouter',
    label: 'OpenRouter — has free models',
    hint: 'free key, ten :free models; also carries Claude/GPT/Gemini when you pay',
    base: 'https://openrouter.ai/api/v1',
    model: 'z-ai/glm-5.2:free',
    free: true,
    keyName: 'OPENROUTER_API_KEY',
    signup: 'https://openrouter.ai/keys',
    models: [
      'z-ai/glm-5.2:free',
      'minimax/minimax-m3:free',
      'nvidia/nemotron-3-ultra-550b-a55b:free',
      'nvidia/nemotron-3-super-120b-a12b:free',
      'nvidia/nemotron-3.5-lightning:free',
      'thinkingmachines/inkling:free',
      'thinkingmachines/inkling-small:free',
      'poolside/laguna-s-2.1:free',
      'poolside/laguna-xs-2.1:free',
      'inclusionai/ling-3.0-flash:free',
    ],
  },
  {
    id: 'nous',
    label: 'Nous Portal — free tier via sign-in',
    hint: 'no key: `hermes auth add nous` once, then model nous/welcome',
    base: '',
    model: 'nous/welcome',
    free: true,
    oauth: 'nous',
  },
  {
    id: 'openai',
    label: 'OpenAI API',
    hint: 'paid key: api.openai.com',
    base: 'https://api.openai.com/v1',
    model: 'gpt-4o-mini',
    keyName: 'OPENAI_API_KEY',
    signup: 'https://platform.openai.com/api-keys',
  },
  {
    id: 'anthropic',
    label: 'Anthropic Claude',
    hint: 'paid key, native Messages API',
    base: 'https://api.anthropic.com',
    model: 'claude-sonnet-4-5',
    keyName: 'ANTHROPIC_API_KEY',
    signup: 'https://console.anthropic.com/settings/keys',
  },
  {
    id: 'openai',
    label: 'A gateway or router (custom BYOK)',
    hint: 'any OpenAI-compatible URL: 9router, LiteLLM, vLLM, Vercel AI Gateway',
    base: '',
    model: '',
    custom: true,
  },
  {
    id: 'openai',
    label: 'A local model server',
    hint: 'LM Studio or Ollama on this machine, usually no key at all',
    base: 'http://127.0.0.1:1234/v1',
    model: '',
    custom: true,
  },
  {
    id: 'skip',
    label: 'Skip — an existing Hermes agent already has a model',
    hint: '',
    base: '',
    model: '',
  },
];

/**
 * Ask the endpoint for its models, then send one real request.
 *
 * Two separate claims: the URL answers, and the key works with that model. A
 * key that lists models but cannot complete is the case worth catching here.
 */
async function verifyEndpoint(base, key, model, protocol, nonInteractive, existing, opts = {}) {
  if (!base) return;
  if (key) {
    process.stdout.write(`${dim('  asking the endpoint for its models…')}\n`);
    const models = await discoverModels(base, key, protocol);
    if (models.length) {
      ok(`${models.length} model${models.length === 1 ? '' : 's'} available`);
      for (const m of models.slice(0, 6)) say(`    ${dim('·')} ${m}`);
      if (models.length > 6) note(`    … and ${models.length - 6} more`);
      // A caller that already chose (a free-model list, an explicit id) must not
      // be asked again: the second prompt would overwrite the first answer.
      if (!nonInteractive && !existing.LLM_MODEL && !opts.picked) {
        const chosen = await ask('Model id', model || models[0]);
        if (chosen) model = chosen;
      }
    } else {
      warn('the endpoint did not list its models; keeping the id you gave');
    }
  }
  if (!model) return;
  process.stdout.write(`${dim(`  sending one real request to ${model}…`)}\n`);
  const probe = await testCompletion(base, key, model, protocol);
  if (probe.ok) ok(`the endpoint answered: ${String(probe.detail).trim().slice(0, 60)}`);
  else {
    bad(`the endpoint refused: ${probe.detail}`);
    note('  Saved anyway. `gb doctor` will check it again.');
  }
}

async function cmdInit(argv) {
  const yes = argv.includes('-y') || argv.includes('--yes');
  const nonInteractive = yes || !process.stdin.isTTY;

  heading('bot-hq setup');
  note('Five decisions, then a working app. Nothing is sent anywhere but the endpoint you name.');

  const existing = readEnvFile().values;
  if (fs.existsSync(ENV_FILE) && !nonInteractive) {
    const keep = await confirm('.env already exists. Update it in place?', true);
    if (!keep) {
      note('Left .env alone. Run `gb doctor` to see what it is missing.');
      return 0;
    }
  }

  // ---- 1. model endpoint ----
  heading('1. Model endpoint');
  if (!nonInteractive) {
    note('Two of these cost nothing: an OpenRouter free key, or Nous sign-in.');
  }
  const choice = nonInteractive ? 0 : await choose('Which model endpoint will the bots use?', PROVIDERS, 0);
  const provider = PROVIDERS[choice];
  const patch = {};

  if (provider.id === 'skip') {
    note('Skipped. Bots will use whatever the existing Hermes agent is configured with.');
  } else if (provider.oauth) {
    // OAuth providers carry no key of ours; Hermes owns the credential.
    patch.LLM_PROVIDER = provider.id;
    patch.LLM_MODEL = provider.model;
    ok(`model ${provider.model}`);
    say(`${bold('One step is yours:')} run ${cyan(`hermes auth add ${provider.oauth}`)} once.`);
    note('  That signs in and stores the credential in Hermes, not in this .env.');
    note('  The free tier is pinned to ' + provider.model + '; other models need a paid plan.');
  } else if (provider.custom) {
    // Custom BYOK: the whole point is that the URL is theirs, not a list ours.
    let base = await ask('Base URL (ends at /v1 usually)', existing.LLM_BASE_URL || provider.base);
    if (!base) base = provider.base;
    base = base.replace(/\/+$/, '');
    let key = existing.LLM_API_KEY ?? '';
    if (!nonInteractive || !key) {
      const entered = await askSecret('API key (input hidden, blank if the server needs none)');
      if (entered) key = entered;
    }
    patch.LLM_BASE_URL = base;
    patch.LLM_PROVIDER = 'openai';
    if (key) patch.LLM_API_KEY = key;
    const model = nonInteractive
      ? (existing.LLM_MODEL || provider.model)
      : await ask('Model id', existing.LLM_MODEL || provider.model);
    patch.LLM_MODEL = model;
    await verifyEndpoint(base, key, model, 'openai', nonInteractive, existing);
  } else {
    let base = provider.base;
    if (!nonInteractive && provider.base) {
      base = await ask('Base URL', existing.LLM_BASE_URL || provider.base);
    }
    base = base.replace(/\/+$/, '');

    if (provider.signup) {
      note(`  Get a key at ${cyan(provider.signup)}`);
    }
    let key = (existing.LLM_API_KEY && existing.LLM_PROVIDER === provider.id) ? existing.LLM_API_KEY : '';
    if (!nonInteractive || !key) {
      const entered = await askSecret('API key (input hidden)');
      if (entered) key = entered;
    }

    patch.LLM_BASE_URL = base;
    patch.LLM_PROVIDER = provider.id === 'anthropic' ? 'anthropic' : 'openai';
    if (key) patch.LLM_API_KEY = key;
    // Hermes reads each provider's own variable name.
    if (key && provider.keyName && provider.keyName !== 'LLM_API_KEY') patch[provider.keyName] = key;

    // A provider with a known free list is offered that list first: it is the
    // reason someone picked it, and a live /models call can be rate limited.
    let model = existing.LLM_MODEL || provider.model;
    if (provider.models?.length && !nonInteractive) {
      say(`${dim('  free models on this provider:')}`);
      provider.models.forEach((m, i) => say(`    ${cyan(String(i + 1))}. ${m}`));
      const pick = await ask('Pick a number, or type a model id', '1');
      const n = Number(pick);
      model = Number.isInteger(n) && n >= 1 && n <= provider.models.length ? provider.models[n - 1] : pick;
    }
    patch.LLM_MODEL = model;
    await verifyEndpoint(base, key, model, patch.LLM_PROVIDER, nonInteractive, existing, { picked: Boolean(provider.models?.length) });
  }

  // ---- 2. computer ----
  heading('2. Where the bots work');
  const docker = await dockerAvailable();
  const desktopChoices = [
    { id: 'docker', label: 'Docker container per user', hint: docker.ok ? 'isolated, nothing of yours is mounted' : 'docker not reachable right now' },
    { id: 'orgo', label: 'A shared computer (Orgo or HQ_LOCAL)', hint: 'one screen per bot, as bot-hq does' },
    { id: 'disabled', label: 'No computer', hint: 'chat only, no screenshots or shell' },
  ];
  const dh = nonInteractive ? 0 : await choose('Where should bots do their work?', desktopChoices, 0);
  patch.DESKTOP_MODE = desktopChoices[dh].id;
  if (desktopChoices[dh].id === 'docker') {
    patch.DESKTOP_IMAGE = existing.DESKTOP_IMAGE || 'grokbot-desktop:latest';
    if (!docker.ok) warn(docker.reason);
    else if (!(await imageExists(patch.DESKTOP_IMAGE))) {
      warn(`image ${patch.DESKTOP_IMAGE} is not built yet`);
      const build = nonInteractive ? false : await confirm('Build it now? It takes a few minutes.', true);
      if (build) {
        say(`${dim(`  docker build -t ${patch.DESKTOP_IMAGE} server/desktop`)}`);
        const code = await run('docker', ['build', '-t', patch.DESKTOP_IMAGE, 'server/desktop']);
        if (code === 0) ok('image built');
        else { bad('the build failed; run it by hand to see why'); }
      } else note(`  Run: docker build -t ${patch.DESKTOP_IMAGE} server/desktop`);
    } else ok(`image ${patch.DESKTOP_IMAGE} is ready`);
  }
  if (desktopChoices[dh].id === 'orgo') {
    patch.ORGO_COMPUTER_ID = existing.ORGO_COMPUTER_ID || (nonInteractive ? '' : await ask('ORGO_COMPUTER_ID', ''));
    if (!nonInteractive && !existing.ORGO_API_KEY) {
      const k = await askSecret('ORGO_API_KEY (input hidden)');
      if (k) patch.ORGO_API_KEY = k;
    }
  }

  // ---- 3. sign-in ----
  heading('3. Sign-in');
  // Off unless asked for: it signs anyone in as any email address, so it is a
  // testing switch and not a default. Non-interactive also leaves it off.
  const signIn = nonInteractive ? false : await confirm('Enable the local email sign-in? (DEV_LOGIN=1, for testing only)', false);
  patch.DEV_LOGIN = signIn ? '1' : '0';
  if (!signIn) {
    warn('Without DEV_LOGIN you need COMPOSIO_API_KEY for Google sign-in.');
    const c = await askSecret('COMPOSIO_API_KEY (input hidden, blank to skip)');
    if (c) patch.COMPOSIO_API_KEY = c;
  }

  // ---- 4. optional capabilities ----
  heading('4. Optional');
  note('Image generation, speech and app connections each need their own endpoint.');
  note('Leave them blank; the app hides the feature instead of failing a click.');
  if (!nonInteractive) {
    if (await confirm('Configure image generation now?', false)) {
      patch.IMAGE_BASE_URL = await ask('IMAGE_BASE_URL', existing.IMAGE_BASE_URL ?? '');
      const k = await askSecret('IMAGE_API_KEY (input hidden)');
      if (k) patch.IMAGE_API_KEY = k;
      patch.IMAGE_MODEL = await ask('IMAGE_MODEL', existing.IMAGE_MODEL ?? '');
    }
    if (await confirm('Configure speech (TTS/STT) now?', false)) {
      patch.TTS_BASE_URL = await ask('TTS_BASE_URL', existing.TTS_BASE_URL ?? '');
      const tk = await askSecret('TTS_API_KEY (input hidden)');
      if (tk) patch.TTS_API_KEY = tk;
      patch.TTS_MODEL = await ask('TTS_MODEL', existing.TTS_MODEL ?? '');
      patch.STT_BASE_URL = await ask('STT_BASE_URL', existing.STT_BASE_URL ?? '');
      patch.STT_MODEL = await ask('STT_MODEL', existing.STT_MODEL ?? '');
    }
  }

  // ---- 5. write ----
  heading('5. Writing .env');
  if (!existing.SESSION_SECRET) patch.SESSION_SECRET = randomHex(32);
  if (!existing.PORT) patch.PORT = '8787';
  if (!existing.APP_URL) patch.APP_URL = 'http://localhost:5173';
  if (!existing.SERVER_URL) patch.SERVER_URL = `http://localhost:${patch.PORT ?? existing.PORT ?? '8787'}`;

  await writeEnv(patch);
  ok(`.env written (mode 600, ${Object.keys(patch).length} values)`);
  note('  Secrets are in .env only. Nothing was printed back.');

  // ---- 6. summary ----
  heading('Done');
  const hermes = await hermesAvailable();
  say(`${bold('Next:')}`);
  if (!hermes) {
    warn('the `hermes` CLI was not found on PATH');
    note('  Bots are run by Hermes agents. Install it, then re-run `gb doctor`.');
  }
  say(`  ${dim('1.')} npm run dev          ${dim('# server on :8787 and web on :5173')}`);
  say(`  ${dim('2.')} open http://localhost:5173`);
  say(`  ${dim('3.')} gb doctor            ${dim('# verify every capability')}`);
  say('');
  note('The first message to a bot starts its Hermes gateway, which may install');
  note('its Python dependencies once. `gb logs <bot>` shows that.');
  return 0;
}

function randomHex(bytes) {
  return randomBytes(bytes).toString('hex');
}

async function cmdDoctor(argv) {
  const json = argv.includes('--json');
  const v = readEnvFile().values;
  const results = [];
  const add = (name, state, detail) => results.push({ name, state, detail });

  add('node', Number(process.versions.node.split('.')[0]) >= 22 ? 'ok' : 'fail', `v${process.versions.node} (needs >=22)`);
  add('dependencies', fs.existsSync(path.join(ROOT, 'node_modules')) ? 'ok' : 'fail', 'run npm ci');

  const base = v.LLM_BASE_URL || '';
  const key = v.LLM_API_KEY || '';
  const model = v.LLM_MODEL || '';
  if (!base && model && v.LLM_PROVIDER && v.LLM_PROVIDER !== 'openai' && v.LLM_PROVIDER !== 'anthropic') {
    // An OAuth provider: the credential is Hermes', so check its store, not ours.
    add('model', 'ok', `${model} via ${v.LLM_PROVIDER} (Hermes holds the credential)`);
  } else if (!base && !v.HERMES_URL) add('model', 'fail', 'no LLM_BASE_URL and no HERMES_URL');
  else if (!base) add('model', 'warn', 'an existing Hermes agent provides the model');
  else if (!key) add('model', 'fail', 'LLM_BASE_URL is set but LLM_API_KEY is empty');
  else if (!model) add('model', 'fail', 'LLM_BASE_URL and LLM_API_KEY are set but LLM_MODEL is empty');
  else {
    const probe = await testCompletion(base, key, model, v.LLM_PROVIDER || 'openai');
    add('model', probe.ok ? 'ok' : 'fail', probe.ok ? `${model} answered` : String(probe.detail).slice(0, 120));
  }

  const mode = v.DESKTOP_MODE || (v.HQ_LOCAL === '1' ? 'mso' : 'docker');
  if (mode === 'disabled') add('computer', 'warn', 'DESKTOP_MODE=disabled, bots have no screen');
  else if (mode === 'docker') {
    const docker = await dockerAvailable();
    if (!docker.ok) add('computer', 'fail', docker.reason);
    else {
      const img = v.DESKTOP_IMAGE || 'grokbot-desktop:latest';
      add('computer', (await imageExists(img)) ? 'ok' : 'fail', (await imageExists(img)) ? `${img} ready` : `build it: docker build -t ${img} server/desktop`);
    }
  } else if (mode === 'orgo') {
    add('computer', v.ORGO_COMPUTER_ID && v.ORGO_API_KEY ? 'ok' : 'fail', v.ORGO_COMPUTER_ID ? 'shared computer configured' : 'ORGO_COMPUTER_ID is empty');
  } else add('computer', 'ok', `mode ${mode}`);

  add('hermes', (await hermesAvailable()) ? 'ok' : 'fail', (await hermesAvailable()) ? 'CLI on PATH' : 'install the `hermes` CLI');
  add('signin', v.DEV_LOGIN === '1' ? 'ok' : v.COMPOSIO_API_KEY ? 'ok' : 'warn', v.DEV_LOGIN === '1' ? 'local email form enabled' : v.COMPOSIO_API_KEY ? 'Composio' : 'set DEV_LOGIN=1 or COMPOSIO_API_KEY');
  add('image', v.IMAGE_BASE_URL && v.IMAGE_API_KEY ? 'ok' : 'off', v.IMAGE_BASE_URL ? 'configured' : 'hidden, no IMAGE_* endpoint');
  add('speech', v.TTS_BASE_URL || v.STT_BASE_URL ? 'ok' : 'off', v.TTS_BASE_URL ? 'configured' : 'hidden, no TTS_*/STT_* endpoint');
  add('apps', v.COMPOSIO_API_KEY ? 'ok' : 'off', v.COMPOSIO_API_KEY ? 'configured' : 'hidden, no COMPOSIO_API_KEY');

  const port = Number(v.PORT || 8787);
  add('port', (await portFree(port)) ? 'ok' : 'warn', (await portFree(port)) ? `${port} is free` : `${port} is in use`);

  if (json) {
    say(JSON.stringify({ results }, null, 2));
    return results.some((r) => r.state === 'fail') ? 1 : 0;
  }

  heading('gb doctor');
  for (const r of results) {
    const mark = r.state === 'ok' ? green('✓') : r.state === 'warn' ? yellow('!') : r.state === 'off' ? dim('–') : red('✗');
    say(`${mark} ${r.name.padEnd(13)} ${dim(r.detail)}`);
  }
  const fails = results.filter((r) => r.state === 'fail');
  say('');
  if (fails.length) {
    bad(`${fails.length} blocker${fails.length === 1 ? '' : 's'}: ${fails.map((f) => f.name).join(', ')}`);
    note('  `gb init` walks through the ones that are config.');
    return 1;
  }
  ok('no blockers');
  return 0;
}

// ---------- run helpers ----------

function run(cmd, args, opts = {}) {
  return new Promise((resolve) => {
    const p = spawn(cmd, args, { stdio: 'inherit', cwd: ROOT, ...opts });
    p.on('error', () => resolve(1));
    p.on('exit', (code) => resolve(code ?? 1));
  });
}

function apiBase() {
  const v = readEnvFile().values;
  return `http://127.0.0.1:${v.PORT || 8787}`;
}

async function cmdCapabilities() {
  const r = await httpProbe(`${apiBase()}/api/capabilities`);
  if (!r.ok) {
    bad(r.status ? `the server answered ${r.status}` : `no server on ${apiBase()} — is it running?`);
    return 1;
  }
  const d = r.json ?? {};
  heading('What this deployment can do');
  say(`${bold('model')}      ${d.model ?? '?'}${d.engine ? ` ${dim('(via a Hermes engine)')}` : ''}`);
  say(`${bold('desktop')}    ${d.desktop?.mode ?? d.desktop ?? '?'}${d.desktop?.ready ? green(' ready') : d.desktop?.ready === false ? red(' not ready') : ''}`);
  say('');
  for (const [name, on] of Object.entries(d.capabilities ?? {})) {
    say(`  ${on ? green('✓') : dim('–')} ${name}`);
  }
  if (d.gaps?.length) {
    say('');
    note(`gaps: ${d.gaps.join(', ')}`);
    note('A gap is hidden in the UI, not a broken button.');
  }
  return 0;
}

async function cmdBots(argv) {
  const sub = argv[0] ?? 'list';
  if (sub === 'list') {
    let r = await httpProbe(`${apiBase()}/api/bots`, { headers: cookieHeader() });
    if (r.status === 401) {
      // One transparent sign-in attempt when the local form is enabled.
      const login = await signIn(readEnvFile().values.DEV_LOGIN_EMAIL || 'dev@local');
      if (login.ok) r = await httpProbe(`${apiBase()}/api/bots`, { headers: cookieHeader() });
    }
    if (!r.ok) {
      bad(`cannot list bots (${r.status || 'no server'})`);
      note(r.status === 401 ? '  Needs DEV_LOGIN=1 and a running server. Try: gb dev' : '  Is the server running? gb dev');
      return 1;
    }
    const bots = r.json?.bots ?? [];
    if (!bots.length) { note('No bots yet. Open the web app and create one.'); return 0; }
    for (const b of bots) {
      const live = r.json.live?.find((l) => l.botId === b.id);
      const state = live?.isRunning ? yellow('running') : live?.awaiting ? cyan('needs you') : dim('idle');
      say(`${b.id}  ${bold(b.name)}${b.label ? ` ${dim(b.label)}` : ''}  ${state}`);
    }
    return 0;
  }
  bad(`unknown: gb bots ${sub}`);
  return 1;
}

let sessionCookie = '';
function cookieHeader() {
  return sessionCookie ? { Cookie: sessionCookie } : {};
}

/** Sign in through the local form and keep the session cookie for this process. */
async function signIn(email) {
  try {
    const res = await fetch(`${apiBase()}/api/auth/dev`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ email }),
      signal: AbortSignal.timeout(10000),
    });
    if (!res.ok) {
      const body = await res.text();
      return { ok: false, detail: body.slice(0, 120) || `HTTP ${res.status}` };
    }
    const raw = res.headers.getSetCookie?.() ?? [];
    const jar = raw.map((c) => c.split(';')[0]).filter(Boolean).join('; ');
    if (jar) sessionCookie = jar;
    return { ok: true };
  } catch (e) {
    return { ok: false, detail: String(e?.message ?? e) };
  }
}

async function cmdLogin(argv) {
  const email = argv[0] || readEnvFile().values.DEV_LOGIN_EMAIL || 'dev@local';
  const r = await signIn(email);
  if (!r.ok) {
    bad(`login failed: ${r.detail}`);
    note('  Needs DEV_LOGIN=1 and a running server. Try: gb dev');
    return 1;
  }
  ok(`signed in as ${email}`);
  return 0;
}

async function cmdLogs(argv) {
  const bot = argv[0];
  if (!bot) { bad('usage: gb logs <bot id>'); return 1; }
  const v = readEnvFile().values;
  const dir = path.join(v.ENGINES_DIR || path.join(ROOT, 'data/engines'), bot, 'logs');
  if (!fs.existsSync(dir)) { bad(`no logs for ${bot} at ${dir}`); note('The gateway writes there on its first turn.'); return 1; }
  const files = (await fsp.readdir(dir)).filter((f) => f.endsWith('.log'));
  if (!files.length) { note('No log files yet.'); return 0; }
  for (const f of files) {
    say(bold(`== ${f}`));
    const tail = await fsp.readFile(path.join(dir, f), 'utf8');
    say(tail.split('\n').slice(-40).join('\n'));
  }
  return 0;
}

async function cmdDev(argv) {
  const which = argv[0];
  if (which && which !== 'server' && which !== 'web') { bad('usage: gb dev [server|web]'); return 1; }
  const args = which ? ['run', 'dev', '-w', which] : ['run', 'dev'];
  return run('npm', args);
}

// ---------- help ----------

function usage() {
  // Pad the verb column by width, not by hand: a space-counted layout drifts the
  // moment a verb gets longer, and the help is the first thing a user reads.
  const rows = [
    ['SETUP', [
      ['init', 'Guided setup: model endpoint, computer, sign-in'],
      ['doctor [--json]', 'Check every capability and name what blocks a turn'],
      ['capabilities', 'What the running server can actually do'],
    ]],
    ['RUN', [
      ['dev [server|web]', 'Start the dev server(s)'],
      ['login [email]', 'Sign in through the local form (needs DEV_LOGIN=1)'],
    ]],
    ['INSPECT', [
      ['bots', 'List bots and whether they are working'],
      ['logs <bot>', "Tail a bot's Hermes gateway log"],
    ]],
  ];
  const width = Math.max(...rows.flatMap(([, items]) => items.map(([v]) => v.length)));
  say(`${bold('gb')} — set up and drive this app`);
  say('');
  say(`${bold('USAGE')}`);
  say('  gb <command> [args]');
  for (const [section, items] of rows) {
    say('');
    say(bold(section));
    for (const [verb, desc] of items) say(`  ${cyan(verb.padEnd(width))}  ${dim(desc)}`);
  }
  say('');
  say(bold('FLAGS'));
  say(`  ${cyan('-y, --yes'.padEnd(width))}  ${dim('Take every default, no questions (CI and scripts)')}`);
  say(`  ${cyan('--json'.padEnd(width))}  ${dim('Machine-readable output where it exists')}`);
  say(`  ${cyan('NO_COLOR=1'.padEnd(width))}  ${dim('No colour')}`);
  say('');
  say(bold('EXAMPLES'));
  const ex = [
    ['gb init', 'the guided path'],
    ['gb init -y', 'defaults, for a script'],
    ['gb doctor', 'after changing .env'],
    ['gb logs bot_abc123', 'why a bot did not answer'],
  ];
  const ew = Math.max(...ex.map(([c]) => c.length));
  for (const [cmdline, note] of ex) say(`  ${cmdline.padEnd(ew)}  ${dim(`# ${note}`)}`);
}

// ---------- main ----------

const [cmd, ...rest] = process.argv.slice(2);

const COMMANDS = {
  init: cmdInit,
  setup: cmdInit,
  doctor: cmdDoctor,
  capabilities: cmdCapabilities,
  caps: cmdCapabilities,
  bots: cmdBots,
  login: cmdLogin,
  logs: cmdLogs,
  dev: cmdDev,
};

async function main() {
  if (!cmd || cmd === '-h' || cmd === '--help' || cmd === 'help') { usage(); return 0; }
  if (cmd === '-v' || cmd === '--version') {
    const pkg = JSON.parse(fs.readFileSync(path.join(ROOT, 'package.json'), 'utf8'));
    say(pkg.version ?? '0.0.0');
    return 0;
  }
  const fn = COMMANDS[cmd];
  if (!fn) {
    bad(`unknown command: ${cmd}`);
    const near = Object.keys(COMMANDS).filter((c) => c.startsWith(cmd[0]));
    if (near.length) note(`  did you mean: ${near.join(', ')}?`);
    say('');
    usage();
    return 1;
  }
  return fn(rest);
}

// exitCode rather than exit(): process.exit() truncates anything still queued on
// stdout, and this CLI writes to stdout right before it returns.
main()
  .then((code) => { process.exitCode = code ?? 0; })
  .catch((e) => {
    bad(String(e?.message ?? e));
    process.exitCode = 1;
  });
