# Copy to .env and fill in what you have. Never commit .env.
#
# Every capability is optional and independent: the server boots with an empty
# file and reports what is missing at GET /api/capabilities. See
# docs/MANEF-PORT.md for the contract.

# ---- the app ----
PORT=8787
APP_URL=http://localhost:5173     # where the web app is served (redirect target after sign-in)
SERVER_URL=http://localhost:8787  # public URL of this server (OAuth callbacks)
SESSION_SECRET=change-me-to-a-long-random-string   # also signs the tokens the agents use to reach /mcp
DEV_LOGIN=1                       # 1 enables POST /api/auth/dev (local testing only)
# ALLOWED_EMAILS: comma-separated emails allowed to sign in; empty = anyone
ALLOWED_EMAILS=
# DB_PATH=./data/grokbot.db       # where the app keeps its SQLite database

# ---- the agents (Hermes) ----
HERMES_BIN=hermes                 # the hermes CLI; it starts one gateway per extra bot
HERMES_URL=http://127.0.0.1:8642  # API server of the agent that already runs (the first bot)
# HERMES_HOME_PRIMARY=~/.hermes   # that agent's home (memory files, .env with API_SERVER_KEY)
# HERMES_KEY=                     # its API key, when not readable from <home>/.env
# ENGINES_DIR=./data/engines      # homes of the extra bots; must be outside ~/.hermes
# ENGINE_PORT_BASE=8650
# MCP_BASE_URL=http://127.0.0.1:8787   # how the agents reach this server
# EXTRA_MCP_SERVERS=              # JSON object of Hermes mcp_servers entries every extra bot gets
# PRIMARY_BOT_NAME=Doug
# PRIMARY_BOT_LABEL=Chief of Staff

# ---- the computer the bots work on ----
# Two shapes, one setting. DESKTOP_MODE=docker gives each user their own local
# container (isolated, no host paths). The shared-computer shape from bot-hq
# (one Orgo computer, one screen per bot) is DESKTOP_MODE=orgo plus
# ORGO_COMPUTER_ID, or HQ_LOCAL=1 when this server runs on that computer.
DESKTOP_MODE=docker               # docker | orgo | mso | disabled
DESKTOP_IMAGE=grokbot-desktop:latest
DESKTOP_RAM_GB=8
DESKTOP_CPU=2
DESKTOP_RESOLUTION=1280x800x24
HQ_LOCAL=0                        # 1 when this server runs on the shared computer (production)
# ORGO_API_KEY may also come from ORGO_API_KEY_FILE=/path/to/file
ORGO_API_KEY=
ORGO_COMPUTER_ID=
# PRIMARY_CDP_URL=http://127.0.0.1:9333   # a Chrome the first bot already owns on the default screen
MAX_BOTS=4                        # four screens per computer

# ---- language model (BYOK; optional when a Hermes engine answers) ----
# Any OpenAI-compatible endpoint that supports POST /responses.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# responses (default) or chat. Set chat for endpoints that do not implement
# /responses; the hosted tools below are then dropped automatically.
LLM_PROTOCOL=responses
# 1 only when the endpoint is the vendor's own and supports hosted web/x search.
LLM_HOSTED_TOOLS=0

# ---- image generation (optional; tool hidden when unset) ----
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# ---- speech (optional, three independent pieces) ----
# Text to speech: POST {base}/audio/speech
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
# Speech to text: POST {base}/audio/transcriptions
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
# Realtime voice: POST {base}/realtime/client_secrets + a websocket. Most
# gateways do not implement this; blank disables calls and keeps dictation.
REALTIME_BASE_URL=
REALTIME_API_KEY=
REALTIME_MODEL=

# ---- connectors and X research ----
COMPOSIO_API_KEY=
# XAI_API_KEY: x_search (research on X) and the voice modes
XAI_API_KEY=
XAI_MODEL=grok-4.7
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_STT_MODEL=grok-voice-transcribe-2.0

# ---- legacy aliases ----
# XAI_BASE_URL / XAI_API_KEY / XAI_MODEL still work; the LLM_* names win when both are set.
