# Copy to .env and fill in what you have. Never commit .env.
#
# Every capability below is optional and independent: the server boots with an
# empty file and reports what is missing at GET /api/capabilities. See
# docs/MANEF-PORT.md for the contract.

# ---------- language model (required for anything to answer) ----------
# Any OpenAI-compatible endpoint that supports POST /responses.
# Examples: https://api.x.ai/v1, https://router.antinrml.com/v1, http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# responses (default) or chat. Set chat for endpoints that do not implement
# /responses; the hosted tools below are then dropped automatically.
LLM_PROTOCOL=responses
# 1 only when the endpoint is the vendor's own and supports hosted web/x search.
LLM_HOSTED_TOOLS=0

# ---------- image generation (optional; tool hidden when unset) ----------
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# ---------- speech (optional, three independent pieces) ----------
# Text to speech: POST {base}/audio/speech
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
# Speech to text: POST {base}/audio/transcriptions
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
# Realtime voice: POST {base}/realtime/client_secrets + a websocket. Most
# gateways do not implement this; leaving it blank disables calls and keeps
# dictation working.
REALTIME_BASE_URL=
REALTIME_API_KEY=
REALTIME_MODEL=

# ---------- bot desktops ----------
# disabled | docker | mso | orgo.
#   docker = one local container per user (this fork's default, best isolation)
#   mso    = host Xvfb displays, no container runtime (needs Xvfb + ffmpeg)
#   orgo   = the original rented VM
DESKTOP_MODE=docker
DESKTOP_IMAGE=grokbot-desktop:latest
DESKTOP_RAM_GB=8
DESKTOP_CPU=2
DESKTOP_RESOLUTION=1280x800x24
DOCKER_SOCKET=/var/run/docker.sock

# -- DESKTOP_MODE=mso only --
MSO_DESKTOP_ROOT=            # default: ~/.grokbot/desktops
MSO_VNC_PORT_BASE=5900       # :99 -> 5900, :91 -> 5901 (one port per display)
GROKBOT_BROWSER=             # optional explicit browser path; else auto-detected
# Then: ./server/scripts/install-desktop-deps.sh   (vendors xdotool/x11vnc/fluxbox)

# ---------- app connections and Google sign-in (optional) ----------
COMPOSIO_API_KEY=

# ---------- server ----------
PORT=8787
APP_URL=http://localhost:5173
SERVER_URL=http://localhost:8787
# Not used for signing (sessions are opaque rows in SQLite); kept so an existing
# .env keeps working.
SESSION_SECRET=
# 1 enables POST /api/auth/dev for local email login without Composio.
DEV_LOGIN=1

# ---------- legacy aliases ----------
# XAI_* and ORGO_* are still read for one release so an upstream .env keeps
# working. Preferred names above win when both are set.
# XAI_BASE_URL=
# XAI_API_KEY=
# XAI_MODEL=
# ORGO_API_KEY=
# ORGO_WORKSPACE_ID=
