# Copy to .env and fill in. Never commit .env.

# ---------- model ----------
# Any OpenAI-compatible endpoint that also implements the Responses API, because the
# agent loop is written against `responses.create`. xAI is the default; a gateway works.
XAI_API_KEY=            # required (or OPENAI_API_KEY)
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7
ENABLE_HOSTED_SEARCH=1  # 0 when the endpoint rejects the web_search/x_search hosted tools
ENABLE_VOICE=0          # 1 to enable xAI realtime voice (needs a real xAI key)

# ---------- apps and sign-in ----------
# Composio powers the app marketplace. With AUTH_PROVIDER=composio it also runs Google
# sign-in. Without a key the server still boots and runs; app connections simply report
# themselves as unconfigured.
COMPOSIO_API_KEY=       # Composio project key (ak_...)

# -- sign-in (WorkOS AuthKit) --
AUTH_PROVIDER=          # workos (default once configured) | composio (legacy Google path)
WORKOS_API_KEY=         # WorkOS secret key (sk_...), server-side only, never logged
WORKOS_CLIENT_ID=       # WorkOS client id (client_...); redirect URI = $SERVER_URL/api/auth/workos/callback

# ---------- computers ----------
# mso (default): each bot's desktop runs on THIS host, no cloud VM.
# orgo: the original cloud-VM backend, for anyone with a key.
COMPUTER_BACKEND=mso

# -- mso backend --
MSO_DESKTOP_ROOT=       # default: ~/.grokbot/desktops
MSO_GEOMETRY=1280x800x24
MSO_VNC_PORT_BASE=5900  # :99 -> 5909, :91 -> 5901
MSO_BASE_URL=http://127.0.0.1:4005
MSO_CLI=                # absolute path to the MSO CLI (optional)

# -- orgo backend (only when COMPUTER_BACKEND=orgo) --
ORGO_API_KEY=
ORGO_WORKSPACE_ID=
ORGO_RAM_GB=8
ORGO_CPU=2
ORGO_RESOLUTION=1280x800x24

# ---------- app ----------
PORT=4000
HOSTNAME_BIND=0.0.0.0   # IPv4; a Traefik/Docker bridge peer cannot reach an IPv6-only bind
APP_URL=http://localhost:5173     # where the web app is served (redirect target after sign-in)
SERVER_URL=http://localhost:4000  # public URL of this server (OAuth callbacks)
SESSION_SECRET=         # openssl rand -hex 32
DEV_LOGIN=1             # 1 enables POST /api/auth/dev (local testing only)
# Sign-in classifies, it does not refuse: everyone can sign in. Staff get the whole
# product; a fan gets a chat Bot with no computer, shell, browser or host files.
# Staff = an address on STAFF_EMAIL_DOMAINS, or in ALLOWED_EMAILS, or on
# ALLOWED_EMAIL_DOMAINS. A staff address whose local part is an artist handle is an
# artist; any other staff address is management.
# Extra staff addresses, comma-separated (no inline comments: the value is the list).
ALLOWED_EMAILS=
# Extra staff domains, comma-separated, leading @ optional.
ALLOWED_EMAIL_DOMAINS=
# The company domain(s). Addresses here are staff.
STAFF_EMAIL_DOMAINS=antinrml.com
